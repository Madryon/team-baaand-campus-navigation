{
  "name": "Team BAAAND Campus Navigation Design System",
  "version": "1.0.0",
  "description": "Design system tokens for Campus Finder mobile-first web app, WCAG 2.2 AA compliant.",
  "color": {
    "primary": {
      "default": "#1B365D",
      "hover": "#12243F",
      "active": "#0B1728",
      "light": "#EBF1F8",
      "border": "#CBD7E6",
      "contrast_on_white": "12.6:1"
    },
    "accent": {
      "default": "#028090",
      "hover": "#016370",
      "light": "#E0F2F4",
      "border": "#A6DADC",
      "contrast_on_white": "4.54:1"
    },
    "landmark": {
      "default": "#D9534F",
      "light": "#FDF2F2",
      "border": "#F5C6C5"
    },
    "neutral": {
      "canvas": "#F8FAFC",
      "surface": "#FFFFFF",
      "subtle": "#F1F5F9",
      "muted": "#E2E8F0",
      "text_primary": "#0F172A",
      "text_secondary": "#334155",
      "text_muted": "#64748B",
      "text_inverse": "#FFFFFF"
    },
    "status": {
      "success": { "default": "#15803D", "bg": "#DCFCE7", "border": "#86EFAC" },
      "warning": { "default": "#B45309", "bg": "#FEF3C7", "border": "#FCD34D" },
      "error": { "default": "#B91C1C", "bg": "#FEE2E2", "border": "#FCA5A5" },
      "info": { "default": "#1D4ED8", "bg": "#DBEAFE", "border": "#93C5FD" }
    },
    "transport": {
      "bicycle": "#0284C7",
      "erickshaw": "#059669",
      "accessible": "#7C3AED"
    }
  },
  "typography": {
    "font_family": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "font_sizes": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "28px"
    },
    "font_weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "line_heights": {
      "tight": 1.25,
      "normal": 1.5,
      "relaxed": 1.625
    }
  },
  "spacing": {
    "scale": "4pt/8pt modular",
    "values": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px"
    },
    "touch_target_min": "44px"
  },
  "radii": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "pill": "9999px"
  },
  "elevation": {
    "sm": "0 1px 2px 0 rgba(15, 23, 42, 0.05)",
    "md": "0 4px 6px -1px rgba(15, 23, 42, 0.08)",
    "lg": "0 10px 15px -3px rgba(15, 23, 42, 0.1)",
    "sheet": "0 -4px 20px rgba(15, 23, 42, 0.12)"
  }
}
